{
  "appId": "com.mkrweb.sunnah24",
  "appName": "Sunnah 24",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "backgroundColor": "#e8f5ee",
  "android": {
    "backgroundColor": "#e8f5ee"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 500,
      "launchAutoHide": true,
